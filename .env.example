# Copia este archivo como .env (NO se sube a GitHub) y completa tus datos.
PORT=3000

# Cadena de conexión a MongoDB Atlas (cada integrante usa su propio usuario de Atlas)
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/kalo?retryWrites=true&w=majority

# Clave para firmar los tokens de sesión (JWT). Usa un texto largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Duración del token
JWT_EXPIRA=8h
