# Configuración de Servidor
PORT=3000

# Cadena de conexión a MongoDB Atlas
# Reemplaza <usuario>, <password> y <cluster> con tus datos reales de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/nutridelivery?retryWrites=true&w=majority

# Ruta alternativa para base SQLite en Railway (si se usa)
# DB_PATH=/app/data/nutridelivery.db

