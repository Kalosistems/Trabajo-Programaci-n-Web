# Copia este archivo como .env (NO se sube a GitHub) y completa tus datos.
PORT=3000

# Base relacional PostgreSQL (en Railway: botón Add → Database → PostgreSQL; la variable DATABASE_URL
# aparece sola en el servicio de la base y se referencia desde el servicio de la app)
DATABASE_URL=postgresql://<usuario>:<clave>@<host>:5432/railway

# Cadena de conexión a MongoDB Atlas (cada integrante usa su propio usuario de Atlas)
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/kalo?retryWrites=true&w=majority

# Clave para firmar los tokens de sesión (JWT). Usa un texto largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Duración del token
JWT_EXPIRA=8h

# Clave para cifrar los datos de salud (peso, altura, IMC, meta) en la base (RNF-02).
# Usa un texto largo y aleatorio y NO la cambies después: los datos cifrados con la clave
# anterior no se podrían leer. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATOS_SALUD_CLAVE=cambia-esto-por-otro-texto-largo-y-aleatorio

# (Producción) dominio permitido para CORS, ej. https://kalo.up.railway.app
# CORS_ORIGEN=
